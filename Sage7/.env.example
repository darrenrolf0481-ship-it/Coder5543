# OPENROUTER_API_KEY: Required for OpenRouter cloud LLM (stable, free tier available at openrouter.ai)
OPENROUTER_API_KEY="sk-or-..."

# GEMINI_API_KEY: Disconnected — no longer used.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SAGE_CORE_PUBKEY: ed25519 public key in 64-char hex format.
# Used to verify the cryptographic signature of fibonacci-vfs.config.json at startup.
# Generate with: openssl genpkey -algorithm ed25519 -out ed25519.pem
# Then extract public key: openssl pkey -in ed25519.pem -pubout -outform DER | xxd -p -c 64
SAGE_CORE_PUBKEY=""
